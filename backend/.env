# 32+ characters. If left empty, a strong key is generated once and saved in backend/.secret_key
SECRET_KEY=
DATABASE_URL=sqlite:///./clinic.db
FRONTEND_URL=http://localhost:5173
SUPERADMIN_NAME=System Administrator
SUPERADMIN_EMAIL=superadmin@clinicpro.com
SUPERADMIN_PASSWORD=clinicpro
# Leave SMTP_HOST empty to keep emails in the in-app Outbox (development).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls for port 587, ssl for port 465, none for a local mail catcher
SMTP_SECURITY=starttls
SMTP_USER=ezekielanyama4@gmail.com
SMTP_PASSWORD=vtpifzeoqvznilyj
SMTP_FROM=ezekielanyama4@gmail.com

# --- Subscription and payments ---------------------------------------------
SUBSCRIPTION_PRICE=1000      # UGX for one paid period
SUBSCRIPTION_HOURS=24        # how long one payment keeps the clinic active
TRIAL_HOURS=2                # free active time after a clinic is approved

# --- Mobile money (real payments) ---------------------------------------
# simulated = demo payments, no real money. live = real MTN MoMo / Airtel Money collections.
PAYMENT_MODE=simulated
PHONE_COUNTRY_CODE=256
# Public https address of this API (lets providers call back; optional, the app also checks payment status itself)
PUBLIC_API_URL=

# MTN MoMo Collections (momodeveloper.mtn.com). Sandbox values shown; for production use
# MTN_BASE_URL=https://proxy.momoapi.mtn.com  MTN_TARGET_ENV=mtnuganda  MTN_CURRENCY=UGX
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_TARGET_ENV=sandbox
MTN_CURRENCY=EUR
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=

# Airtel Money (developers.airtel.africa). Test server shown; for production use https://openapi.airtel.africa
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=UG
AIRTEL_CURRENCY=UGX
